# ==============================================================================
# HEALIT MOBILE APP — ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. MAIN DOMAIN & API SERVERS (Change these when hosting your backend/web)
EXPO_PUBLIC_SITE_URL=https://healit.app
EXPO_PUBLIC_BASE_URL=https://api.healit.app
EXPO_PUBLIC_API_URL=https://api.healit.app/api/v1
EXPO_PUBLIC_WS_URL=wss://api.healit.app/ws
EXPO_PUBLIC_CDN_IMAGE_URL=https://images.healit.app

# 2. ENVIRONMENT SETTINGS
# Options: 'development' | 'staging' | 'production'
EXPO_PUBLIC_ENV=production

# 3. MOCK & DEMO FALLBACK
# Set to 'true' to seamlessly fallback to rich mock data if backend server is unreachable
EXPO_PUBLIC_ENABLE_MOCK_FALLBACK=true

# 4. NETWORK & TIMEOUT
EXPO_PUBLIC_API_TIMEOUT=15000
