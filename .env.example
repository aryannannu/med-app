# ==========================================
# HEALIT MOBILE APP — ENVIRONMENT TEMPLATE
# ==========================================

# Base API Server Endpoint (e.g., https://your-backend-api.com/api/v1)
EXPO_PUBLIC_API_URL=https://api.healit.app/api/v1

# Environment Mode: 'development' | 'staging' | 'production'
EXPO_PUBLIC_ENV=production

# Graceful Mock Data Fallback
EXPO_PUBLIC_ENABLE_MOCK_FALLBACK=true

# API Request Timeout in Milliseconds
EXPO_PUBLIC_API_TIMEOUT=15000
